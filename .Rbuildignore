^.*\.Rproj$
^\.Rproj\.user$
^src/.*\.tmp$
^\.github$
^\.github/
^LICENSE\.md$

# Exclude pkgdown configuration
^_pkgdown\.yml$

# Exclude pkgdown-generated docs
^docs/

# Exclude Windows DLLs
^src/.*\.dll$

# Exclude other build artifacts
^.*\.o$
^.*\.so$
^.*\.dylib$

# pkgdown-only articles, if any (vignettes/articles), and vignettes built locally
^vignettes/articles$
^doc$
^Meta$
# Rewrite workspace (not part of the package)
^CLAUDE\.md$
^CLAUDE\.local\.md$
^\.claude$
^dev$
^validation$
^\.gitattributes$
^\.lintr$
^\.clang-format$
# CRAN submission notes (DEC-077)
^cran-comments\.md$
# Fixture datasets that copy the bundled data; the tests build them from data/ (DEC-076)
^tests/testthat/fixtures/reference/datasets/binary_example\.rds$
^tests/testthat/fixtures/reference/datasets/binary_example_list\.rds$
^tests/testthat/fixtures/reference/datasets/linear_example\.rds$
^tests/testthat/fixtures/reference/datasets/linear_example_list\.rds$
