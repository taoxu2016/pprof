^.*\.Rproj$
^\.Rproj\.user$
^src/.*\.tmp$
^\.github$
^\.github/
^pprof/docs/deps/bootstrap-5\.3\.1/fonts/.+
^LICENSE\.md$

# Exclude pkgdown configuration
^_pkgdown\.yml$

# Exclude cleanup script
^cleanup\.txt$

# Exclude incorrect configure script
^configure\.txt$

# Exclude pkgdown-generated docs
^docs/

# Exclude Windows DLLs
^pprof/src/.*\.dll$
^src/.*\.dll$

# Exclude other build artifacts
^.*\.o$
^.*\.so$
^.*\.dylib$

# Exclude vignettes folder
^vignettes/
# Rewrite workspace (not part of the package)
^CLAUDE\.md$
^CLAUDE\.local\.md$
^\.claude$
^dev$
^validation$
^\.gitattributes$
