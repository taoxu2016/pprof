{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(Rscript *)",
      "Bash(R CMD build *)",
      "Bash(R CMD check *)",
      "Bash(R CMD INSTALL *)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(git rebase *)",
      "Bash(git clean *)",
      "Bash(git branch -D *)",
      "Bash(git tag *)",
      "Bash(rm -rf *)",
      "Bash(Rscript dev/reference/*)",
      "Edit(/dev/coxph_brief.md)",
      "Edit(/CLAUDE.md)"
    ],
    "deny": ["Edit(/tests/testthat/fixtures/reference/**)", "Edit(/tests/testthat/fixtures/cox/**)"]
  }
}
